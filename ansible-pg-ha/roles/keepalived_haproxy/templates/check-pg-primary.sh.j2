#!/usr/bin/env bash
set -euo pipefail

source /etc/haproxy/pg-primary-check.env
database_address="${HAPROXY_SERVER_ADDR:-}"
database_port="${HAPROXY_SERVER_PORT:-}"

if [[ -z "${database_address}" ]]; then
  database_address="${3:-}"
fi

if [[ -z "${database_port}" ]]; then
  database_port="${4:-{{ postgresql_port }}}"
fi

[[ -n "${database_address}" ]]

result="$(
  PGPASSWORD="${PG_PRIMARY_CHECK_PASSWORD}" \
  psql "host=${database_address} port=${database_port} dbname={{ app_database }} user={{ haproxy_health_user }} sslmode=require connect_timeout=3" \
    --no-align --tuples-only --command="SELECT pg_is_in_recovery();" 2>/dev/null
)"

[[ "${result}" == "f" ]]
